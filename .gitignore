# Godot 4+ specific ignores
.godot/
.mcp/

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Node.js and npm
node_modules/
npm-debug.log
dist/

# System files
.DS_Store
Thumbs.db

# Build artifacts
*.o
*.os
*.obj
*.bc
*.pyc
*.pyo
__pycache__/

# Various temporary files
*.swp
*~
.~lock.*

# Test runner (fetched by CI, not vendored)
addons/gut/

# Integration-test scratch dirs and AI tool temp files (never commit)
.tmp_*
.test_tmp_*
.codeartsdoer/
.workbuddy/

# Goal-flow integration test scratch project (test_game_goal_flow.py)
tmp_goal_flow_project/
releases/

# Benchmark / integration scratch workspaces (created by runners)
tmp_benchmark_project/
tmp_representative_game/

# Slice B：插件同步物与编辑器缓存不入库（setup.ps1 负责同步）
slice_b/addons/
slice_b/.godot/
slice_b/art/*.tres
slice_b/audio/*.wav
slice_b/audio/*.import
